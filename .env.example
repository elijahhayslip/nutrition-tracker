# ── Robinhood credentials ─────────────────────────────────────────────────────
ROBINHOOD_USERNAME=your@email.com
ROBINHOOD_PASSWORD=your_password
ROBINHOOD_MFA_CODE=            # leave blank if MFA is disabled

# ── Anthropic (for AI analysis) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Hard limits ───────────────────────────────────────────────────────────────
# Stop ALL trading if daily loss exceeds this % of session-open equity
MAX_DAILY_LOSS_PCT=2.0

# Stop ALL trading if drawdown from session peak exceeds this %
MAX_DRAWDOWN_PCT=5.0

# Auto-trim (sell) any position that grows beyond this % of total equity
MAX_POSITION_SIZE_PCT=20.0

# Cancel new buy orders once open position count reaches this number
MAX_OPEN_POSITIONS=10

# Cancel buy orders when cash falls below this % of total equity
MIN_CASH_RESERVE_PCT=10.0

# Block any single order whose USD value exceeds this amount
MAX_SINGLE_ORDER_USD=5000.0

# ── Supervisor behaviour ──────────────────────────────────────────────────────
# How often to poll (seconds). 300 = every 5 minutes.
POLL_INTERVAL_SECONDS=300

# Set to false to run rule-only mode without calling Claude
ENABLE_AI_ANALYSIS=true

# Set to false to log violations but NOT auto-sell to fix them
ENABLE_AUTO_TRIM=true

# Set to true to simulate all actions without placing real orders
DRY_RUN=false

AUDIT_LOG_FILE=supervisor_audit.jsonl
STATE_FILE=supervisor_state.json
